{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".wrangler/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "out/**",
    "src/data/migrations/**",
    "worker-configuration.d.ts",
    "bun.lock",
    "*.md",
    "**/*.md"
  ],
  "insertFinalNewline": true,
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
